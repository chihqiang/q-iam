# 版本控制
.git
.gitignore

# 文档
**/*.md
docs/

# Docker 相关
Dockerfile
.dockerignore

# 依赖目录
**/node_modules

# 前端构建产物（由 Docker 多阶段构建阶段生成，无需打进构建上下文）
**/dist
**/*.tsbuildinfo

# Go 测试/覆盖率产物
**/*.test
**/coverage.*

# 运行时数据（SQLite 数据库等，防止把宿主机数据打进镜像）
**/*.db
**/*.db-shm
**/*.db-wal

# 环境变量（可能包含密钥/token）
**/.env
**/.env.*
!**/.env.example

# 本地数据/日志目录
data/
**/logs/
*.log

# 编辑器/IDE
.vscode/
.idea/
.DS_Store
