# ============================================================
# q-iam 前端环境变量模板
# ------------------------------------------------------------
# 复制为 .env 后按需修改：
#   cp .env.example .env
# .env 已被 .gitignore 忽略（可能包含密钥/token），不会提交。
# ============================================================

# cookie 子域共享域名（可选）：留空则仅当前主机，跨子域共享登录态时配置，如 .example.com
VITE_AUTH_DOMAIN=

# 开发环境代理目标：Vite 将 /api 请求转发到该后端地址
VITE_API_PROXY_TARGET=http://127.0.0.1:8080
